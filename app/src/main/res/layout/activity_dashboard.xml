<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Air Quality Dashboard"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:id="@+id/aqiText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AQI"
            android:textSize="30sp"
            android:textColor="#FF0000"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pollution Status"
            android:textSize="22sp"
            android:layout_marginBottom="30dp"/>

        <!-- My Profile Button -->

        <Button
            android:id="@+id/myProfileBtn"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:layout_marginBottom="20dp"/>

        <!-- Realtime Database Button -->

        <Button
            android:id="@+id/realtimeBtn"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Realtime Data"
            android:layout_marginBottom="10dp"/>

        <!-- Prediction Button -->

        <Button
            android:id="@+id/predictionBtn"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Prediction"
            android:layout_marginBottom="20dp"/>


    </LinearLayout>
</ScrollView>