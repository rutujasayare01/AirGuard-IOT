<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2EE"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Industry Registration"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A2E1A"
            android:layout_marginBottom="20dp"/>

        <!-- NAME -->
        <EditText
            android:id="@+id/industryName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Industry Name"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- EMAIL -->
        <EditText
            android:id="@+id/industryEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- PASSWORD -->
        <EditText
            android:id="@+id/industryPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- PHONE -->
        <EditText
            android:id="@+id/industryPhone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Phone Number"
            android:inputType="phone"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- TYPE -->
        <EditText
            android:id="@+id/industryType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Industry Type"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- LOCATION -->
        <Spinner
            android:id="@+id/locationSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- BUTTON -->
        <Button
            android:id="@+id/registerBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Register Industry"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32"/>

    </LinearLayout>

</ScrollView>