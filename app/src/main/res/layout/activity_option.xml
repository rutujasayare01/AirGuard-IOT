<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4EF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== BLUE HEADER ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#005A8E"
            android:orientation="vertical"
            android:padding="22dp"
            android:paddingBottom="60dp">

            <!-- Logo Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="22dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="🌿"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:background="#26FFFFFF"
                    android:layout_marginEnd="10dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AirGuard IoT"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Industrial Monitoring"
                        android:textColor="#99FFFFFF"
                        android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Avatar Icon -->
            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="👤"
                android:textSize="30sp"
                android:gravity="center"
                android:background="#33FFFFFF"
                android:layout_marginBottom="14dp"/>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Panel"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login or create a new account"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="5dp"/>

        </LinearLayout>

        <!-- ===== WHITE CARD ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_top_rounded"
            android:layout_marginTop="-28dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:paddingTop="32dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT AN OPTION"
                android:textColor="#5A7060"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp"/>

            <!-- LOGIN BUTTON — same id ✅ -->
            <Button
                android:id="@+id/loginBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="User Login"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/btn_dark_blue"
                android:stateListAnimator="@null"
                android:layout_marginBottom="14dp"/>

            <!-- OR Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E0EBE2"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  OR  "
                    android:textColor="#5A7060"
                    android:textSize="11sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E0EBE2"/>

            </LinearLayout>

            <!-- REGISTER BUTTON — same id ✅ -->
            <Button
                android:id="@+id/registerBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="User Registration"
                android:textColor="#005A8E"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/btn_outline_dark_blue"
                android:stateListAnimator="@null"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New here? Register to start monitoring air quality"
                android:textColor="#5A7060"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>